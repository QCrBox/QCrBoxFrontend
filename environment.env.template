DEBUG=False

DJANGO_DB='postgresql'
POSTGRES_HOST='db'
POSTGRES_NAME='postgres'
POSTGRES_USER='postgres'
POSTGRES_PASSWORD='postgres'
POSTGRES_PORT=5432

# Registry API, reached directly on the shared QCrBox docker network
# (server-to-server; browser traffic goes through Traefik + Authelia instead).
API_BASE_URL='http://qcrbox-registry:8000'

# Domain QCrBox is served under; must match QCRBOX_DOMAIN of the QCrBox stack.
QCRBOX_DOMAIN='localhost.local'
ALLOWED_HOSTS='localhost.local'
CSRF_TRUSTED_ORIGINS='https://localhost.local'

# Single sign-on: trust the Remote-User header set by Authelia via Traefik.
# Only enable when the frontend is reachable exclusively through the reverse
# proxy (no published host ports).
AUTHELIA_SSO=True
AUTHELIA_LOGOUT_URL='https://auth.localhost.local/logout'

# Leave empty when QCrBox serves HTTPS on the default port 443.
TRAEFIK_HTTP_PORT=''
GUI_DOMAIN_PREFIX='.gui.'

MAX_LENGTH_API_LOG=10000

DJANGO_SUPERUSER_EMAIL=None
DJANGO_SUPERUSER_USERNAME=None
DJANGO_SUPERUSER_PASSWORD=None
